    <!-- Actors (UML Stick Figures with distinct colors & clear positioning) -->
    <mxCell id="2" value="Maker (Người nhập)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
